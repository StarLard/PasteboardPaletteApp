// Local.example.xcconfig
// Pasteboard Palette
//
// Copy this file to `Config/Local.xcconfig` (which is git-ignored) and fill in
// your own values. They override the defaults in `Shared.xcconfig`.

// Your reverse-DNS prefix, e.g. com.yourname
BUNDLE_ID_PREFIX = com.yourname

// Your 10-character Apple Developer Team ID (optional).
// Find it at https://developer.apple.com/account under Membership details.
// DEVELOPMENT_TEAM = ABCDE12345
